# Copy to .env (repo root) and fill in. Used by local scripts only (the setlist.fm spike,
# and later seed/test scripts). Never commit real values.

# setlist.fm API key (free, non-commercial): https://api.setlist.fm/docs/1.0/index.html
SETLISTFM_API_KEY=

# Supabase, for scripts and RLS tests (from `pnpm db:status`).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key bypasses RLS: scripts/tests only, NEVER in a web or mobile client.
SUPABASE_SERVICE_ROLE_KEY=
