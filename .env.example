# Copy to .env (repo root) and fill in. Used by local scripts and tests only (the setlist.fm
# spike, API smoke tests). Never commit real values.

# setlist.fm API key (free, non-commercial): https://api.setlist.fm/docs/1.0/index.html
SETLISTFM_API_KEY=

# Supabase, for scripts and tests. Local values: `pnpm db:status` (API_URL, PUBLISHABLE_KEY,
# SECRET_KEY). The API smoke tests fall back to the local defaults if these are empty.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) bypasses RLS: scripts/tests only, NEVER in a web or mobile client.
SUPABASE_SECRET_KEY=
