# Copy to supabase/functions/.env for local Edge Functions (`supabase functions serve`).
# For the hosted project, set it with `pnpm supabase secrets set SETLISTFM_API_KEY=...`.
# Never commit real values.

SETLISTFM_API_KEY=

# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase itself
# (locally by `pnpm functions:serve`, and in the hosted project). setlist-search uses the service
# role only to read the signing key and count each user's searches; don't add them here.
