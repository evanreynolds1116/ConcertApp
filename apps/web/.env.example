# Copy to apps/web/.env.local and fill in. Never commit real values.
# Local values: `pnpm db:status` (API_URL and PUBLISHABLE_KEY) after `pnpm db:start`.
# Hosted values: Supabase dashboard > Project Settings > API Keys.

# Supabase API URL, e.g. http://127.0.0.1:54321 locally
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe for the browser; RLS enforces privacy.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The setlist.fm key does NOT go here. It lives only in the setlist-search Edge Function.
