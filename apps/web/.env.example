# Copy to apps/web/.env.local and fill in. Never commit real values.
# Local values come from `pnpm db:status` (after `pnpm db:start`);
# hosted values from the Supabase dashboard > Project Settings > API.

# Supabase API URL, e.g. http://127.0.0.1:54321 locally
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon / publishable key (safe for the browser; RLS enforces privacy)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The setlist.fm key does NOT go here. It lives only in the setlist-search Edge Function.
